[Unit]
Description=Padakhep Sentinel - control-plane API (FastAPI)
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=simple
# __ROOT__ / __VENV__ / __ENVFILE__ substituted by install.sh
WorkingDirectory=__ROOT__
EnvironmentFile=-__ENVFILE__
Environment=PYTHONUNBUFFERED=1
# Launch via run.py so TLS turns on automatically when SENTINEL_SSL_CERT/KEY are
# set in the env file (SEN-006). Bind host via SENTINEL_HOST (default 0.0.0.0 —
# prefer a management interface / behind a TLS proxy in production).
ExecStart=__VENV__/bin/python -m controlplane.app.run
Restart=on-failure
RestartSec=5
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
