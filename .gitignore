# AV-safe: plaintext YARA rules trip endpoint antivirus (they contain malware
# signature strings). Only the packed blob (av_content/rulepack.b64) is tracked.
av_content/yara/*.yar

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# PyInstaller build artifacts / binaries
build/
dist/
*.spec
*.exe

# local dev db / secrets
*.db
sentinel.db
.sshcreds*
vt_usage.json

# AV-safe: behavior patterns carry AMSI/LSASS/procdump tokens -> blob only
av_content/behaviors.json

# Wazuh/OSSEC alert logs (not project source)
logs/
